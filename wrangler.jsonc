/**
 * FlareQR Studio – Cloudflare Workers configuration.
 *
 * Deploys with `npm run deploy` or the "Deploy to Cloudflare" button without
 * editing anything: there is no account_id, zone_id, route or hard-coded
 * resource id. The single D1 database below has no `database_id` on purpose –
 * Wrangler and the deploy button provision it automatically, and the Worker
 * creates its tables on first use. It stores the admin password, the settings
 * made in the Admin area and the built-in dynamic links.
 *
 * Optional variables (all can also be configured in the Admin area):
 *   ADMIN_PASSWORD        – skip the first-run password setup (set as a secret)
 *   API_TOKEN             – require a bearer token for /api/v1/* (secret)
 *   CORS_ALLOWED_ORIGINS  – comma-separated origins allowed to call the API
 *   MAX_RASTER_SIZE       – maximum PNG/JPEG width rendered by the API
 *   APP_NAME              – display name
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flareqr-studio",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-03",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*"],
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flareqr-studio",
    },
  ],
  "observability": {
    "enabled": true,
    // Head sampling keeps logs useful without recording every invocation.
    // The Worker never writes request bodies or QR payloads to logs.
    "head_sampling_rate": 0.1,
  },
}
