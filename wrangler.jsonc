/**
 * EdgeQR Studio – Cloudflare Workers configuration.
 *
 * This file intentionally contains NO account_id, zone_id, routes, KV/D1/R2
 * bindings or secrets. A clean checkout deploys to <name>.<subdomain>.workers.dev
 * with `npm run deploy` or the "Deploy to Cloudflare" button.
 *
 * The optional dynamic-QR module (D1-backed short links) is documented in
 * docs/dynamic-qr.md and configured through wrangler.dynamic.example.jsonc.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgeqr-studio",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-03",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*"],
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    // Head sampling keeps logs useful without recording every invocation.
    // The Worker never writes request bodies or QR payloads to logs.
    "head_sampling_rate": 0.1
  },
  "vars": {
    // Public, non-secret defaults. Override per deployment in the dashboard or
    // with `wrangler secret put` for sensitive values such as API_TOKEN.
    "APP_NAME": "EdgeQR Studio",
    // Comma-separated list of origins allowed to call the API cross-origin.
    // Empty means same-origin only (no CORS headers are emitted).
    "CORS_ALLOWED_ORIGINS": "",
    // Maximum raster edge length the API will render (pixels).
    "MAX_RASTER_SIZE": "4096",
    // Set to "true" (and add a D1 binding named DYNAMIC_DB) to enable the
    // optional dynamic QR module.
    "DYNAMIC_QR_ENABLED": "false"
  }
}
