{
  "name": "flareqr-studio",
  "version": "1.1.0",
  "private": true,
  "description": "Self-hosted, privacy-first QR code studio running on Cloudflare Workers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit && vitest run --project workers",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:watch": "vitest --project unit",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "icons": "node scripts/generate-icons.mjs",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0",
    "zxing-wasm": "^3.1.3"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "miniflare": "5.20260831.0-alpha",
      "wrangler": "$wrangler"
    }
  }
}
